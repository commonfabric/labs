    "properties": {
      "adopted": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": [],
        "description": "The keys of the current rules adopted from the pool, which publishing\nleaves out (`adoptedAfter`).",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "goal": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": "",
        "description": "The yes-or-no question, such as \"Is this email a bill?\".",
        "type": "string"
      },
      "heldOutPercent": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": 30,
        "description": "The share of items held out to score proposals on, in percent.",
        "type": "number"
      },
      "hifiModel": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": "",
        "description": "The model that labels items and proposes rules. Empty, the deployment's\ndefault `generateObject` model answers; any model the gateway lists\n(`/api/ai/llm/models`) can be named.",
        "type": "string"
      },
      "history": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": [],
        "description": "Every judged proposal, accepted or not.",
        "items": {
          "$ref": "#/$defs/HistoryEntry"
        },
        "type": "array"
      },
      "items": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": [],
        "description": "The items to label. Anything can feed them, through `addItem`.",
        "items": {
          "$ref": "#/$defs/Item"
        },
        "type": "array"
      },
      "pool": {
        "$ref": "#/$defs/PoolTarget",
        "description": "The pool to publish to. Omitted, the inductor wishes for a\n`#inductorPool`; either way it publishes only to a pool for its goal."
      },
      "pseudonym": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": "",
        "description": "This piece's pseudonym in the goal's pool, minted on the first publish.\nOne piece holds one goal, so it is one per goal. Each piece mints its\nown, so the strings do not relate across goals, but they are not\nunlinkable: the pool space's commits and `authored-by` labels name the\nperson's core identity (CFC debt cut 2, see the README).",
        "type": "string"
      },
      "published": {
        "anyOf": [
          {
            "$ref": "#/$defs/Published"
          },
          {
            "type": "null"
          }
        ],
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": null,
        "description": "The rules as last published, or null."
      },
      "rewriteAfter": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": 3,
        "description": "How many new surprises start a rewrite.",
        "type": "number"
      },
      "rewriteAttempt": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": 0,
        "description": "Retries of the current rewrite's failed model call.",
        "type": "number"
      },
      "rules": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ],
        "default": [],
        "description": "The current rule set, in canonical form.",
        "items": {
          "$ref": "#/$defs/CanonicalRule"
        },
        "type": "array"
      }
    },
    "type": "object"
  },

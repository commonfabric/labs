    "description": "Induces cheap regex rules for a yes-or-no question from a model's answers. #classifier #learning",
    "properties": {
      "$FS": {
        "description": "The goal, rules, counts, and proposal history as Markdown.",
        "properties": {
          "content": {
            "type": "string"
          },
          "frontmatter": {
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          },
          "type": {
            "enum": [
              "text/markdown"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "frontmatter",
          "content"
        ],
        "type": "object"
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "addItem": {
        "$ref": "#/$defs/SubmittedItem",
        "asCell": [
          "stream"
        ],
        "description": "Add one item: string fields, at least one, and an optional id that\ndeduplicates (an id the list holds already adds nothing). An item with no\nfields is refused; the event's schema drops a field that is not a string\nbefore the verb sees it."
      },
      "addItems": {
        "$ref": "#/$defs/SubmittedItems",
        "asCell": [
          "stream"
        ],
        "description": "Add several items at once, each as `addItem` takes it."
      },
      "adopted": {
        "description": "The keys of the current rules adopted from the pool, never published.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "goal": {
        "type": "string"
      },
      "heldOutF1": {
        "description": "The current rules' F1 on the held-out items.",
        "type": "number"
      },
      "heldOutPercent": {
        "description": "The share of items held out to score proposals on, in percent.",
        "type": "number"
      },
      "hifiModel": {
        "description": "The model that labels items and proposes rules, or \"\" for the default.",
        "type": "string"
      },
      "history": {
        "items": {
          "$ref": "#/$defs/HistoryEntry"
        },
        "type": "array"
      },
      "items": {
        "items": {
          "$ref": "#/$defs/Item"
        },
        "type": "array"
      },
      "poolOffer": {
        "anyOf": [
          {
            "$ref": "#/$defs/PoolOffer"
          },
          {
            "type": "null"
          }
        ],
        "description": "The pool's released rules for this goal, judged as a candidate set on\nthis piece's held-out items, or null when there is nothing new to offer."
      },
      "pseudonym": {
        "description": "This piece's pseudonym in the goal's pool, or \"\" before it publishes.",
        "type": "string"
      },
      "publish": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Publish the current rules for the goal."
      },
      "published": {
        "anyOf": [
          {
            "$ref": "#/$defs/Published"
          },
          {
            "type": "null"
          }
        ]
      },
      "removeItem": {
        "$ref": "#/$defs/ItemRef",
        "asCell": [
          "stream"
        ],
        "description": "Take one item out, by reference: the item as read from `items`. An item\nthe list no longer holds changes nothing."
      },
      "removeRule": {
        "$ref": "#/$defs/RuleRef",
        "asCell": [
          "stream"
        ],
        "description": "Take one rule out of the current set: the rule with the given rule's\ncanonical `key`, as read from `rules`. A rule the set no longer holds\nchanges nothing; one without a key is refused."
      },
      "resetRules": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Empty the current rule set. The history stays."
      },
      "retryRewrite": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Ask the model again after the rewrite's call failed."
      },
      "rewrite": {
        "$ref": "#/$defs/RewriteStatus",
        "description": "Where the current rewrite stands."
      },
      "rewriteAfter": {
        "description": "How many new surprises start a rewrite.",
        "type": "number"
      },
      "rows": {
        "description": "Every item with its hi-fi and lo-fi labels.",
        "items": {
          "$ref": "#/$defs/ItemRow"
        },
        "type": "array"
      },
      "rules": {
        "items": {
          "$ref": "#/$defs/CanonicalRule"
        },
        "type": "array"
      },
      "setGoal": {
        "$ref": "#/$defs/GoalEvent",
        "asCell": [
          "stream"
        ],
        "description": "Ask a new question. The old goal's contribution is withdrawn from its\npool, and the rules, the history, the pseudonym, and what was published\nwere all for the old question, so they are cleared; the items stay, and\nthe hi-fi model labels them for the new question. The same question again\nchanges nothing; a blank one is refused."
      },
      "setHeldOutPercent": {
        "$ref": "#/$defs/HeldOutPercentEvent",
        "asCell": [
          "stream"
        ],
        "description": "Set the held-out share: a number above 0 and below 100."
      },
      "setHifiModel": {
        "$ref": "#/$defs/HifiModelEvent",
        "asCell": [
          "stream"
        ],
        "description": "Name the model, or \"\" for the default. Every item is asked again."
      },
      "setRewriteAfter": {
        "$ref": "#/$defs/RewriteAfterEvent",
        "asCell": [
          "stream"
        ],
        "description": "Set how many new surprises start a rewrite: a whole number, at least 1."
      },
      "settlePoolOffer": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Record the pool offer's judgement: adopt the pool's rules if they were\naccepted, and add the round to the history either way."
      },
      "settleRewrite": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Record the rewrite's judgement once it is ready: adopt the proposed set if\nit was accepted, and add the round to the history either way."
      },
      "summary": {
        "$ref": "#/$defs/Summary"
      },
      "unpublish": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "Take this piece's contribution back out of the goal's pool and forget\nwhat was published. The pseudonym stays, for the next publish."
      }
    },
    "required": [
      "goal",
      "items",
      "rules",
      "history",
      "published",
      "pseudonym",

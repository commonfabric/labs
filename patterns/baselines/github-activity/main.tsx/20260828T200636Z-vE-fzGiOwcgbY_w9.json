          "updatedAt": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "visible",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "number",
          "url",
          "title",
          "repository",
          "repositoryUrl",
          "baseRefName",
          "baseRefOid",
          "headRefName",
          "headRefOid",
          "headRepository",
          "headRepositoryUrl",
          "isDraft",
          "mergeable",
          "mergeState",
          "reviewDecision",
          "checkState",
          "createdAt",
          "updatedAt",
          "observedAt",
          "visibility",
          "status"
        ],
        "type": "object"
      },

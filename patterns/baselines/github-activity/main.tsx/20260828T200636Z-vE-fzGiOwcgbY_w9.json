        "properties": {
          "schema": {
            "enum": [
              "commonfabric.github-connector.pull-request.v1"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "PullRequestStatus": {
        "enum": [
          "draft",
          "tests-failed",
          "tests-running",
          "merge-conflicts",
          "merge-blocked",
          "visibility-unknown",
          "green-and-can-land"
        ]
      }
    },
    "description": "Inputs for connector data and the public-repository fallback.",

            "required": [
              "spaceDid",
              "cells"
            ],
            "type": "object"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "service",
          "formatVersion",
          "status",
          "startedAt",
          "updatedAt",
          "target"
        ],
        "type": "object"
      },

            "type": "string"
          },
          "generation": {
            "type": "number"
          },
          "lastCompleteCollectionAt": {
            "type": "string"
          },
          "pullRequests": {
            "items": {
              "$ref": "#/$defs/GithubPullRequestIndexRow"

            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sync": {
            "properties": {
              "completedAt": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "pullRequestCount": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "reason",
              "status",
              "startedAt"
            ],
            "type": "object"
          },
          "target": {
            "properties": {
              "cells": {
                "properties": {
                  "health": {
                    "type": "string"
                  },
                  "index": {
                    "type": "string"
                  }
                },

                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "headRepositoryUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "isDraft": {
            "type": "boolean"
          },
          "mergeState": {
            "type": "string"
          },
          "mergeable": {
            "enum": [
              "CONFLICTING",
              "MERGEABLE",
              "UNKNOWN"
            ]
          },
          "number": {
            "type": "number"
          },
          "observedAt": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": "string"
          },
          "reviewDecision": {

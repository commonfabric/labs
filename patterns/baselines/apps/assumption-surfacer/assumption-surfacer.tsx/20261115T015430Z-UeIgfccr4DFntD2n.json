{
  "argumentSchema": {
    "$defs": {
      "Assumption": {
        "properties": {
          "about": {
            "description": "A short excerpt of that user message, so the card says what it was about.",
            "type": "string"
          },
          "alternatives": {
            "description": "The options the assistant weighed, each a few words.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "assumedIndex": {
            "description": "The alternative the assistant assumed.",
            "type": "number"
          },
          "chosenIndex": {
            "description": "The alternative the user chose instead, when `status` is \"corrected\".",
            "type": "number"
          },
          "description": {
            "description": "At most one short sentence, or \"\".",
            "type": "string"
          },
          "id": {
            "description": "Stable within one conversation: `a1`, `a2`, … in recording order.",
            "type": "string"
          },
          "label": {
            "description": "Two to four words, such as \"Language\" or \"Skill level\".",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/AssumptionStatus"
          },
          "turn": {
            "description": "Which user message (1-based) the reply rested on this assumption.",
            "type": "number"
          }
        },
        "required": [
          "id",
          "turn",
          "about",
          "label",
          "description",
          "alternatives",
          "assumedIndex",
          "status",
          "chosenIndex"
        ],
        "type": "object"
      },
      "AssumptionStatus": {
        "enum": [
          "open",
          "confirmed",
          "corrected",
          "rejected"
        ]
      },
      "BuiltInLLMContent": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "$ref": "#/$defs/BuiltInLLMContentPart"
            },
            "type": "array"
          }
        ]
      },
      "BuiltInLLMContentPart": {
        "anyOf": [
          {
            "$ref": "#/$defs/BuiltInLLMTextPart"
          },
          {
            "$ref": "#/$defs/BuiltInLLMImagePart"
          },
          {
            "$ref": "#/$defs/BuiltInLLMToolCallPart"
          },
          {
            "$ref": "#/$defs/BuiltInLLMToolResultPart"
          }
        ]
      },
      "BuiltInLLMImagePart": {
        "properties": {
          "image": {
            "type": "string"
          },

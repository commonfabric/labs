        "anyOf": [
          {
            "type": "undefined"
          },
          {
            "$ref": "#/$defs/FieldAnchors"
          }
        ],
        "description": "Where each comment's text is now: the body's anchors, two per comment,\ndrafts included. The text of the comment `id` runs from the anchor\n`<id>:from` to the anchor `<id>:to`. `undefined` until the body first\nholds an anchor."
      },
      "comments": {
        "items": {
          "$ref": "#/$defs/StoredComment"
        },
        "scope": "space",
        "type": "array"
      },

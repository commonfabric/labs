      },
      "addComment": {
        "$ref": "#/$defs/AddCommentEvent",
        "asCell": [
          "stream"
        ],
        "description": "Comments under the caller's profile on the one occurrence of `quote` in\nthe body, and refuses when `quote` is empty, occurs nowhere, or occurs\nmore than once, when `body` has no text, or when the caller has no\nprofile."
      },
      "appendLine": {
        "$ref": "#/$defs/LineEvent",
        "asCell": [
          "stream"
        ],
        "description": "Adds `text` to the end of the document, on a line of its own."
      },

{
  "argumentSchema": {
    "$defs": {
      "CommentAnchor": {
        "properties": {
          "from": {
            "description": "Start of the range, as an open editor last mapped it.",
            "type": "number"
          },
          "quote": {
            "description": "The text the range held when the comment was made. It re-finds the\ncomment once the range no longer holds it.",
            "type": "string"
          },
          "to": {
            "description": "End of the range, exclusive.",
            "type": "number"
          }
        },
        "required": [
          "from",
          "to",
          "quote"
        ],
        "type": "object"
      },
      "CommentReply": {
        "properties": {
          "authorProfile": {
            "$ref": "#/$defs/NoteProfile",
            "asCell": [
              "cell"
            ],
            "description": "The profile the reply was made under."
          },
          "body": {
            "description": "The reply's text.",
            "type": "string"
          },
          "createdAt": {
            "description": "The handler clock when the reply was made, in milliseconds.",
            "type": "number"
          }
        },
        "required": [
          "authorProfile",
          "body",
          "createdAt"
        ],
        "type": "object"
      },
      "NoteComment": {
        "properties": {
          "anchor": {
            "$ref": "#/$defs/CommentAnchor",
            "description": "Where the comment sits."
          },
          "authorProfile": {
            "$ref": "#/$defs/NoteProfile",
            "asCell": [
              "cell"
            ],
            "description": "The profile the comment was made under."
          },
          "body": {
            "description": "The comment's text.",
            "type": "string"
          },
          "createdAt": {
            "description": "The handler clock when the comment was made, in milliseconds.",
            "type": "number"
          },
          "id": {
            "description": "Names the comment to the editor and the verbs; minted when it is made.",
            "type": "string"
          },
          "replies": {
            "description": "Replies in the order made. A reply is not anchored, so this does not recurse.",
            "items": {
              "$ref": "#/$defs/CommentReply"
            },
            "type": "array"
          },
          "resolved": {
            "description": "Whether the comment is settled. A resolved comment marks no text.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "anchor",
          "authorProfile",
          "body",
          "createdAt",
          "resolved",
          "replies"
        ],
        "type": "object"
      },
      "NoteProfile": {
        "properties": {
          "avatar": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "description": "Initial document values, shared by every viewer of this piece.",
    "properties": {
      "comments": {
        "default": [],
        "description": "Comments on the body, shared by every viewer.",
        "items": {
          "$ref": "#/$defs/NoteComment"
        },
        "scope": "space",
        "type": "array"
      },
      "content": {
        "default": "",
        "description": "LF-normalized Markdown; live editing uses CodeMirror operations.",
        "scope": "space",
        "type": "string"
      },
      "title": {
        "default": "Untitled note",
        "description": "Editable document title, independent of Markdown frontmatter.",
        "scope": "space",
        "type": "string"
      }
    },
    "type": "object"
  },
  "pattern": "apps/shared-note/main.tsx",
  "resultSchema": {
    "$defs": {
      "AddCommentEvent": {
        "properties": {
          "body": {
            "description": "The comment's text.",
            "type": "string"
          },
          "quote": {
            "description": "Text the body holds exactly once, compared code unit for code unit.",
            "type": "string"
          }
        },
        "required": [
          "quote",
          "body"
        ],
        "type": "object"
      },
      "CommentAnchor": {
        "properties": {
          "from": {
            "description": "Start of the range, as an open editor last mapped it.",
            "type": "number"
          },
          "quote": {
            "description": "The text the range held when the comment was made. It re-finds the\ncomment once the range no longer holds it.",
            "type": "string"
          },
          "to": {
            "description": "End of the range, exclusive.",
            "type": "number"
          }
        },
        "required": [
          "from",
          "to",
          "quote"
        ],
        "type": "object"
      },
      "CommentIdEvent": {
        "properties": {
          "id": {
            "description": "The comment's `id`.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "CommentReply": {
        "properties": {
          "authorProfile": {
            "$ref": "#/$defs/NoteProfile",
            "description": "The profile the reply was made under."
          },
          "body": {
            "description": "The reply's text.",
            "type": "string"
          },
          "createdAt": {
            "description": "The handler clock when the reply was made, in milliseconds.",
            "type": "number"
          }
        },
        "required": [
          "authorProfile",
          "body",
          "createdAt"
        ],
        "type": "object"
      },
      "LineEvent": {
        "properties": {
          "text": {
            "description": "The line, without a trailing newline.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "NoteComment": {
        "properties": {
          "anchor": {
            "$ref": "#/$defs/CommentAnchor",
            "description": "Where the comment sits."
          },
          "authorProfile": {
            "$ref": "#/$defs/NoteProfile",
            "description": "The profile the comment was made under."
          },
          "body": {
            "description": "The comment's text.",
            "type": "string"
          },
          "createdAt": {
            "description": "The handler clock when the comment was made, in milliseconds.",
            "type": "number"
          },
          "id": {
            "description": "Names the comment to the editor and the verbs; minted when it is made.",
            "type": "string"
          },
          "replies": {
            "description": "Replies in the order made. A reply is not anchored, so this does not recurse.",
            "items": {
              "$ref": "#/$defs/CommentReply"
            },
            "type": "array"
          },
          "resolved": {
            "description": "Whether the comment is settled. A resolved comment marks no text.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "anchor",
          "authorProfile",
          "body",
          "createdAt",
          "resolved",
          "replies"
        ],
        "type": "object"
      },
      "NoteProfile": {
        "properties": {
          "avatar": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ReplaceTextEvent": {
        "properties": {
          "new": {
            "description": "Text that takes its place.",
            "type": "string"
          },
          "old": {
            "description": "Text the document holds exactly once, compared code unit for code unit.",
            "type": "string"
          }
        },
        "required": [
          "old",
          "new"
        ],
        "type": "object"
      }
    },
    "description": "Readable Markdown and the same compact view for standalone and embedded use.",
    "properties": {
      "$NAME": {
        "type": "string"
      },
      "$TILE_UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "addComment": {
        "$ref": "#/$defs/AddCommentEvent",
        "asCell": [
          "stream"
        ],
        "description": "Adds a comment under the caller's profile, anchored on the one occurrence\nof `quote`, and refuses when `quote` is empty, occurs nowhere, or occurs\nmore than once, when `body` is blank, or when the caller has no profile."
      },
      "appendLine": {
        "$ref": "#/$defs/LineEvent",
        "asCell": [
          "stream"
        ],
        "description": "Adds `text` to the end of the document, on a line of its own."
      },
      "comments": {
        "items": {
          "$ref": "#/$defs/NoteComment"
        },
        "scope": "space",
        "type": "array"
      },
      "content": {
        "scope": "space",
        "type": "string"
      },
      "participantName": {
        "scope": "user",
        "type": "string"
      },
      "prependLine": {
        "$ref": "#/$defs/LineEvent",
        "asCell": [
          "stream"
        ],
        "description": "Adds `text` to the start of the document, on a line of its own."
      },
      "replaceText": {
        "$ref": "#/$defs/ReplaceTextEvent",
        "asCell": [
          "stream"
        ],
        "description": "Replaces the one occurrence of `old` in the document with `new`, and\nrefuses when `old` is empty, occurs nowhere, or occurs more than once."
      },
      "resolveComment": {
        "$ref": "#/$defs/CommentIdEvent",
        "asCell": [
          "stream"
        ],
        "description": "Marks the comment named by `id` resolved, and refuses an unknown `id`."
      },
      "title": {
        "scope": "space",
        "type": "string"
      }
    },
    "required": [
      "title",
      "content",
      "comments",
      "participantName",
      "appendLine",
      "prependLine",
      "replaceText",
      "addComment",
      "resolveComment",
      "$NAME",
      "$UI",
      "$TILE_UI"
    ],
    "type": "object"
  }
}

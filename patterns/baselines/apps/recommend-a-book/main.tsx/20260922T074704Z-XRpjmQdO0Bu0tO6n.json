          "ownerPrincipal": {
            "__ctCurrentPrincipal": true
          },
          "writeAuthorizedBy": {
            "__ctWriterIdentityOf": {
              "file": "/packages/patterns/recommend-a-book/main.tsx",
              "moduleIdentity": "-Yo3oy3b9FMraS7ap_0HubcqtCBMDP4vfkxlQJ9ERuI",

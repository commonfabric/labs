              "avatar": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "url": {
            "description": "Absolute URL the bytes are served from.",
            "type": "string"
          }
        },
        "required": [
          "uploadedBy",
          "id",
          "name",
          "mediaType",
          "size",
          "url"

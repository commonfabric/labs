        "required": [
          "uploadedBy",
          "id",
          "name",
          "mediaType",
          "size",
          "url"
        ],
        "type": "object"
      },
      "UploadedFile": {
        "properties": {
          "id": {
            "description": "Hash of the media type and bytes, prefixed `fid1:`.",
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "url": {
            "description": "Absolute URL the bytes are served from.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mediaType",
          "size",
          "url"
        ],
        "type": "object"
      },
      "ViewerClaim": {
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "properties": {
              "avatar": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "$NAME": {
        "type": "string"

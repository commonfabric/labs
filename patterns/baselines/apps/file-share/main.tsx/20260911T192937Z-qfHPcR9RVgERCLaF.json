        "type": "object"
      },
      "SharedFile": {
        "properties": {
          "id": {
            "description": "Hash of the media type and bytes, prefixed `fid1:`.",
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "uploadedBy": {
            "properties": {
              "avatar": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "url": {
            "description": "Absolute URL the bytes are served from.",
            "type": "string"
          }

            "default": {
              "kind": "person",
              "name": ""
            }
          },
          "createdByName": {
            "type": "string"
          },
          "lastActivityAt": {
            "default": 0,
            "type": [
              "number",
              "undefined"
            ]
          },
          "links": {
            "items": {
              "$ref": "#/$defs/TopicLink"
            },
            "type": "array"
          },
          "setBody": {
            "$ref": "#/$defs/SetBodyEvent",
            "asCell": [
              "stream"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "comments",
          "links",
          "addComment",
          "addLink",
          "setBody",
          "title",
          "body",
          "createdAt",
          "createdByName",
          "commentCount",
          "lastActivityAt",
          "$NAME"

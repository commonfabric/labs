          "url",
          "label"
        ],
        "type": "object"
      },
      "TopicLinkKind": {
        "enum": [
          "pr",
          "topic",
          "session",
          "web"
        ]
      },
      "TopicReference": {
        "properties": {
          "$NAME": {
            "default": "",
            "description": "The topic's display name. Like the other derived display fields, a cold\nretained sibling may not have produced this path yet; its persisted title\nremains authoritative until it does.",
            "type": [
              "string",
              "undefined"
            ]
          },
          "addComment": {
            "$ref": "#/$defs/AddCommentEvent",
            "asCell": [
              "stream"
            ]
          },
          "addLink": {

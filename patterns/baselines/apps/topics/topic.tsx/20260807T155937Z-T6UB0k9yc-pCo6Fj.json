      "createdByName": {
        "default": "",
        "type": "string"
      },
      "links": {
        "asCell": [
          "cell"
        ],
        "default": [],
        "items": {
          "$ref": "#/$defs/TopicLink"
        },
        "type": "array"
      },
      "mentionable": {
        "asCell": [
          "cell"
        ],
        "default": [],
        "description": "The board's own topics list — the sibling set for this topic's derived\ncrossrefs and the mention universe for authoring. A reference to the\ntracker's array, wired at creation like `myName` (and backfillable as a\none-time link-bind on pieces created before it existed). Absent, the\ndetail page simply derives no connections.\n\nDeclared at the deployed reference type: this is the pattern's accepted\nargument, not a read. What bounds the read is the parameter type of the\nderivation that consumes it (`topicCrossrefView` below takes `TopicScan`),\nwhich is where a narrow declaration actually costs a consumer nothing.",
        "items": {
          "$ref": "#/$defs/TopicReference"
        },
        "type": "array"
      },
      "myName": {
        "asCell": [
          {
            "kind": "cell",
            "scope": "user"
          }
        ],
        "default": "",
        "type": "string"
      },
      "title": {
        "asCell": [
          "cell"
        ],
        "default": "",
        "type": "string"
      }
    },
    "type": "object"
  },

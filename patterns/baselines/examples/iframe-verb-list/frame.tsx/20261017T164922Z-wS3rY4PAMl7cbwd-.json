{
  "argumentSchema": {
    "$defs": {
      "AddItemEvent": {
        "properties": {
          "id": {
            "description": "Id for the new item. An id the list already holds adds nothing.",
            "type": "string"
          },
          "text": {
            "description": "Text of the new item. Whitespace around it is dropped.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "IframeInputData": {
        "properties": {
          "items": {
            "description": "Every item on the list, in the order they were added.",
            "items": {
              "$ref": "#/$defs/ListItem"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ListItem": {
        "properties": {
          "id": {
            "description": "Stable id, minted by whoever asked for the item.",
            "type": "string"
          },
          "text": {
            "description": "What the entry says.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      }
    },
    "properties": {
      "addItem": {
        "$ref": "#/$defs/AddItemEvent",
        "asCell": [
          "stream"
        ]
      },
      "input": {
        "$ref": "#/$defs/IframeInputData",
        "default": {
          "items": []
        }
      }
    },
    "required": [
      "addItem"
    ],
    "type": "object"
  },
  "pattern": "iframe-verb-list/frame.tsx",
  "resultSchema": {
    "$defs": {
      "IframeOutputData": {
        "properties": {
          "hideChecked": {
            "description": "Whether the list hides the items that are checked off.",
            "type": "boolean"
          }
        },
        "required": [
          "hideChecked"
        ],
        "type": "object"
      },
      "IframeStateData": {
        "properties": {
          "checked": {
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Whether each item is checked off, by item id.",
            "properties": {},
            "type": "object"
          }
        },
        "required": [
          "checked"
        ],
        "type": "object"
      }
    },
    "properties": {
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "output": {
        "$ref": "#/$defs/IframeOutputData"
      },
      "state": {
        "$ref": "#/$defs/IframeStateData"
      }
    },
    "required": [
      "state",
      "output",
      "$NAME",
      "$UI"
    ],
    "type": "object"
  }
}

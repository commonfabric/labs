                "type": "string"
              }
            },
            "type": "object"
          },
          "avatar": {
            "description": "Sender's profile avatar (URL or glyph), snapshotted at send time.",
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "sentAt": {
            "type": "number"
          }

          "content",
          "timestamp",
          "type",
          "reactions"
        ],
        "type": "object"
      },
      "Reaction": {
        "properties": {
          "emoji": {
            "type": "string"
          },
          "userNames": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "emoji",
          "userNames"
        ],
        "type": "object"
      },
      "User": {
        "properties": {
          "avatar": {
            "description": "Avatar URL or glyph, snapshotted from the joiner's shared profile.",
            "type": "string"

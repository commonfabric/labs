{
  "argumentSchema": {
    "$defs": {
      "SqliteDatabase": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "rev": {
            "type": "number"
          },
          "tables": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "predicate": {
        "default": "",
        "description": "A SQL boolean expression over the table's own columns. Empty counts every\nrow.",
        "type": "string"
      },
      "source": {
        "$ref": "#/$defs/SqliteDatabase",
        "asCell": [
          "sqlite"
        ],
        "description": "The database to count in. Whoever wired the input chose which."
      },
      "table": {
        "description": "The table to count, by the name the store declares it under.",
        "type": "string"
      }
    },
    "required": [
      "source",
      "table"
    ],
    "type": "object"
  },
  "pattern": "primitives/source-row-count.tsx",
  "resultSchema": {
    "properties": {
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "errorMessage": {
        "description": "Why the read failed, empty while it has not.",
        "type": "string"
      },
      "matching": {

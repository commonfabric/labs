        "type": "number"
      },
      "pending": {
        "type": "boolean"
      },
      "predicate": {
        "description": "The predicate `matching` counted under, empty when it counted every row.",
        "type": "string"
      },
      "table": {
        "description": "The table the numbers below were read from.",
        "type": "string"
      },
      "total": {
        "description": "Every row the table holds.",
        "type": "number"
      }
    },
    "required": [
      "table",
      "predicate",
      "total",
      "matching",
      "pending",
      "errorMessage",

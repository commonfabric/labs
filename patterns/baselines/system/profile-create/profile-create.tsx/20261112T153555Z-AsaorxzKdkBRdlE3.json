      "profileSuggestion": {
        "anyOf": [
          {
            "type": "undefined"
          },
          {
            "$ref": "#/$defs/ProfileSuggestion"
          }
        ],
        "asCell": [
          "cell"
        ],
        "description": "The profile the user's host suggests, which the `#profile` wish hands\nover. Its name starts the field in place of `defaultName`; its picture is\nshown, with a control that removes it, and the profile created takes the\npicture still shown. The user may remove it or choose their own, which\nthe surface records for itself and leaves this suggestion as the host\nstored it; creating a profile leaves the suggestion stored for the host\nto replace, and the wish shows this surface only while the user has no\nprofile."
      },

            "items": {
              "$ref": "#/$defs/CatalogRemixStep"
            },
            "type": "array"
          },
          "standalone": {
            "description": "Whether its author offers it to a person choosing what to place, on its\nown at the top of a loom. Every pattern is also a part other patterns\nmay build from; one that is not standalone is only that. A host sets it\non every entry; an entry without it, stored before the field existed,\nis a part.",
            "type": "boolean"
          },

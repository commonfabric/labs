{
  "argumentSchema": {
    "asCell": [
      "opaque"
    ]
  },
  "pattern": "system/default-app/default-app.tsx",
  "resultSchema": {
    "$defs": {
      "AnonymousType_3": {
        "items": {
          "$ref": "#/$defs/MentionablePiece"
        },
        "type": "array"
      },
      "MentionablePiece": {
        "properties": {
          "$NAME": {
            "type": "string"
          },
          "backlinks": {
            "$ref": "#/$defs/AnonymousType_3"
          },
          "isHidden": {
            "type": "boolean"
          },
          "isMentionable": {
            "type": "boolean"
          },
          "mentionable": {
            "anyOf": [
              {
                "$ref": "#/$defs/AnonymousType_3"
              },
              {
                "properties": {},
                "type": "object"
              }
            ]
          },
          "mentioned": {
            "$ref": "#/$defs/AnonymousType_3"
          }
        },
        "type": "object"
      },
      "SpaceGrantLevel": {
        "enum": [
          "READ",
          "WRITE",
          "OWNER"
        ]
      },
      "SpaceMember": {
        "properties": {
          "level": {
            "$ref": "#/$defs/SpaceGrantLevel"
          },
          "principal": {
            "type": "string"
          },
          "profiles": {
            "items": {
              "properties": {
                "avatar": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "principal",
          "level",
          "profiles"
        ],
        "type": "object"
      }
    },
    "additionalProperties": {
      "type": "unknown"
    },
    "properties": {
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "addParticipant": {
        "asCell": [
          "stream"
        ],
        "description": "Adds a labeled profile to `participants` once.",
        "properties": {
          "profile": {
            "properties": {
              "avatar": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "profile"
        ],
        "type": "object"
      },
      "addPiece": {
        "asCell": [
          "stream"
        ],
        "properties": {
          "piece": {
            "$ref": "#/$defs/MentionablePiece"
          }
        },
        "required": [
          "piece"
        ],
        "type": "object"
      },
      "backlinksIndex": {
        "properties": {
          "mentionable": {
            "anyOf": [
              {
                "type": "undefined"
              },
              {
                "$ref": "#/$defs/AnonymousType_3"
              }
            ]
          }
        },
        "required": [
          "mentionable"
        ],
        "type": "object"
      },
      "members": {
        "description": "The members of the space (`memberSet()`): one for each principal its\naccess list names, sorted by DID, with the level the list grants them,\nand those of the profiles `participants` lists that are their own, in\nthat order. The list's `\"*\"` entry adds no member, and a profile that is\nno one's, or whose owner the list doesn't name, counts toward no one. So\ndoes a profile the reader can't read, so it is derived for each reader.\nAbsent while the reader can't read the list.",
        "items": {
          "$ref": "#/$defs/SpaceMember"
        },
        "scope": "user",
        "type": "array"
      },
      "participants": {
        "description": "Fabric profiles of the space's participants, each the live profile cell\nin its own space, in the order they were added. Any participant may add\nany profile, so an entry is a claim: it does not say that the profile's\nprincipal holds access to the space.",
        "items": {
          "properties": {
            "avatar": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "pieceRegistry": {
        "$ref": "#/$defs/AnonymousType_3"
      },
      "sidebarUI": {
        "type": "unknown"
      }
    },
    "required": [
      "backlinksIndex",
      "pieceRegistry",
      "addPiece",
      "participants",
      "addParticipant",
      "$UI"
    ],
    "type": "object"
  }
}

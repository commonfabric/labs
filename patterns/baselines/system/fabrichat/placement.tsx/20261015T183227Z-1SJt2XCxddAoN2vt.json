{
  "argumentSchema": {
    "$defs": {
      "AboutRecord": {
        "properties": {
          "createdAt": {
            "description": "When the room was created.",
            "type": "FabricEpochNsec"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "How the room was created."
          },
          "title": {
            "description": "The title a group room was created with.",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ChatProfile": {
        "properties": {
          "avatar": {
            "description": "The person's avatar: a URL or a glyph, if they have set one.",
            "type": "string"
          },
          "name": {
            "description": "The person's display name, if they have set one.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChatReaction": {
        "properties": {
          "emoji": {
            "description": "A single emoji.",
            "type": "string"
          },
          "reactorProfile": {
            "$ref": "#/$defs/ChatProfile",
            "asCell": [
              "cell"
            ],
            "description": "The profile the reactor reacted under."
          },
          "sentAt": {
            "description": "The room's handler clock when it recorded the reaction.",
            "type": "FabricEpochNsec"
          }
        },
        "required": [
          "reactorProfile",
          "emoji",
          "sentAt"
        ],
        "type": "object"
      },
      "ChatRoomAbout": {
        "properties": {
          "createdAt": {
            "description": "When the room was created; absent for a space's own chat.",
            "type": "FabricEpochNsec"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "`\"direct\"` if created as a direct room; `\"group\"` otherwise."
          },
          "policy": {
            "$ref": "#/$defs/ChatRoomPolicy",
            "asCell": [
              "cell"
            ],
            "description": "The room's policy, stated correctly, in a document of its own."
          },
          "record": {
            "$ref": "#/$defs/AboutRecord",
            "asCell": [
              "cell"
            ],
            "description": "The record the room's creator wrote, whose label names them; absent for a\nspace's own chat, which no one created as a room."
          },
          "title": {
            "description": "The room's title, which every member shares: the one a member last set,\nor else the one the room was created with. A direct room has none until a\nmember sets one, and a space's own chat has none.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "policy"
        ],
        "type": "object"
      },
      "ChatRoomKind": {
        "enum": [
          "direct",
          "group"
        ]
      },
      "ChatRoomPolicy": {
        "properties": {
          "deletionIsObliteration": {
            "description": "Whether a sender's deletion of their own message obliterates it.",
            "type": "boolean"
          },
          "keepsHistory": {
            "description": "Whether an edit or a plain deletion keeps the version it replaces.",
            "type": "boolean"
          },
          "maxOpenWindows": {
            "description": "The most message windows a session can have open.",
            "type": "number"
          },
          "maxWindowCount": {
            "description": "The most messages a message window holds.",
            "type": "number"
          },
          "ownersMayObliterate": {
            "description": "Whether an OWNER may obliterate messages.",
            "type": "boolean"
          },
          "proposedTimeMaxAgeNsec": {
            "description": "How far before the room's clock a proposed time is accepted, in ns.",
            "type": "FabricDurationNsec"
          },
          "proposedTimeMaxLeadNsec": {
            "description": "How far after the room's clock a proposed time is accepted, in ns.",
            "type": "FabricDurationNsec"
          },
          "recentActivityWindowNsec": {
            "description": "How long an entry stays in `recentActivity`, in ns.",
            "type": "FabricDurationNsec"
          }
        },
        "required": [
          "ownersMayObliterate",
          "keepsHistory",
          "deletionIsObliteration",
          "proposedTimeMaxAgeNsec",
          "proposedTimeMaxLeadNsec",
          "recentActivityWindowNsec",
          "maxWindowCount",
          "maxOpenWindows"
        ],
        "type": "object"
      },
      "PlacedMessage": {
        "properties": {
          "reactions": {
            "description": "Everyone's reactions to the message.",
            "items": {
              "$ref": "#/$defs/ChatReaction"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "PlacedMessageList": {
        "properties": {
          "count": {
            "description": "How many messages the room holds.",
            "type": "number"
          },
          "latest": {
            "description": "The newest messages of the main conversation.",
            "properties": {
              "hasOlder": {
                "type": "boolean"
              },
              "messages": {
                "items": {
                  "$ref": "#/$defs/PlacedMessage",
                  "asCell": [
                    "cell"
                  ]
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "PlacedRoom": {
        "properties": {
          "about": {
            "$ref": "#/$defs/ChatRoomAbout",
            "description": "What the room says about itself."
          },
          "canSend": {
            "description": "Whether the reader can send.",
            "type": "boolean"
          },
          "messages": {
            "$ref": "#/$defs/PlacedMessageList",
            "description": "The room's messages."
          },
          "participants": {
            "description": "The room's participants.",
            "items": {
              "$ref": "#/$defs/ChatProfile",
              "asCell": [
                "cell"
              ]
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "description": "What a placement holds.",
    "properties": {
      "room": {
        "$ref": "#/$defs/PlacedRoom",
        "asCell": [
          "cell"
        ],
        "description": "The room, set when the placement is created."
      }
    },
    "required": [
      "room"
    ],
    "type": "object"
  },
  "pattern": "fabrichat/placement.tsx",
  "resultSchema": {
    "$defs": {

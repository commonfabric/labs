+}
+await Deno.writeTextFile(output + ".json", JSON.stringify({posture:{ cfcEnforcementMode:"enforce-explicit",cfcFlowLabels:"persist" },renders,updates,profileStartMs,cacheHits:getFrozenObjectHashCacheHits(),result}));

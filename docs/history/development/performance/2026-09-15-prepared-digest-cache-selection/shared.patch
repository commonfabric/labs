+import { deepFreeze, getFrozenObjectHashCacheHits, hashStringOf } from "@commonfabric/data-model";
+import { preparedDigestFor } from "../packages/runner/src/cfc/canonical.ts";
+import type { PreparedDigestInput } from "../packages/runner/src/cfc/types.ts";
+const gc = (globalThis as { gc?: () => void }).gc!;
+if (!gc) throw new Error("Run with --v8-flags=--expose-gc");
+const space = "did:key:digest-gc" as const;
+const schema = deepFreeze({ type: "object", ifc: { confidentiality: ["private"] } });
+const payload = deepFreeze({ text: "x".repeat(10240), schema });
+const address = (id: number) => ({ space, id: `of:${id}`, scope: "space" as const, path: [] });
+function input(changed = false): PreparedDigestInput {
+  return {
+    consumedReads: Array.from({length:300},(_,i)=>deepFreeze(address(i))),
+    attemptedWrites: [], writes: [], writeAttemptLog: [], triggerReads: [],
+    dereferenceTraces: Array.from({length:300},(_,i)=>deepFreeze({source:address(i),target:address(i+1),kind:"value" as const})),
+    writePolicyInputs: Array.from({length:50},(_,i)=>deepFreeze({kind:"custom" as const,name:`p${i}`,target:address(i),value:changed&&i===0?{text:"changed",schema}:payload})),
+  };
+}
+const retained = input();
+const digest = preparedDigestFor(retained);
+gc();
+let hits = getFrozenObjectHashCacheHits();
+const afterGc = preparedDigestFor(retained);
+const retainedHits = getFrozenObjectHashCacheHits()-hits;
+hits=getFrozenObjectHashCacheHits();
+const fresh = preparedDigestFor(input());
+const freshHits = getFrozenObjectHashCacheHits()-hits;
+const changed = preparedDigestFor(input(true));
+const object = deepFreeze({ payload });
+hashStringOf(object);gc();hits=getFrozenObjectHashCacheHits();hashStringOf(object);
+const ordinaryRetainedHits=getFrozenObjectHashCacheHits()-hits;
+console.log(JSON.stringify({retainedHits,freshHits,ordinaryRetainedHits,sameDigest:afterGc===digest&&fresh===digest,changedDigest:changed!==digest}));

+import { ExtendedStorageTransaction } from "../packages/runner/src/storage/extended-storage-transaction.ts";
+import { canonicalizePreparedDigestInput } from "../packages/runner/src/cfc/canonical.ts";
+import { deepEqual } from "@commonfabric/utils/deep-equal";
+import type { PreparedDigestInput } from "../packages/runner/src/cfc/types.ts";
+const prior = new WeakMap<object,{digest:string,input:PreparedDigestInput}>();
+const activityProbe = { prepared:0,withAction:0,repeatedAction:0,sameDigest:0,samePolicies:0,identityMatches:{reads:0,traces:0,policies:0},records:{reads:0,traces:0,policies:0},changedFields:{} as Record<string,number> };
+const prepare = ExtendedStorageTransaction.prototype.prepareCfc;
+ExtendedStorageTransaction.prototype.prepareCfc = function() {
+ const digest=prepare.call(this);activityProbe.prepared++;
+ const action=this.tx.sourceAction;
+ if(!action||!digest)return digest;
+ activityProbe.withAction++;
+ const input=canonicalizePreparedDigestInput(this.accessForTestingOnly.buildPreparedDigestInput());
+ const old=prior.get(action);
+ if(old){
+  activityProbe.repeatedAction++;
+  if(old.digest===digest)activityProbe.sameDigest++;
+  if(deepEqual(old.input.writePolicyInputs,input.writePolicyInputs))activityProbe.samePolicies++;
+  for(const [name,key] of [['reads','consumedReads'],['traces','dereferenceTraces'],['policies','writePolicyInputs']] as const){
+   const previous=new Set<object>(old.input[key]);
+   activityProbe.records[name]+=input[key].length;
+   activityProbe.identityMatches[name]+=input[key].filter(record=>previous.has(record)).length;
+  }
+  for(const key of Object.keys(input) as (keyof PreparedDigestInput)[]){
+   if(!deepEqual(old.input[key],input[key]))activityProbe.changedFields[key]=(activityProbe.changedFields[key]??0)+1;
+  }
+ }
+ prior.set(action,{digest,input});return digest;
+};
+
+import { Session } from "node:inspector";
+import { runTestPattern } from "../packages/cli/lib/test-runner.ts";
+import { getFrozenObjectHashCacheHits } from "@commonfabric/data-model";
+const output = Deno.env.get("DIGEST_BENCH_OUT")!;
+const profiled = Deno.env.get("DIGEST_BENCH_PROFILE") === "1";
+const session = new Session();
+const post = (method: string, params = {}) => new Promise<any>((resolve,reject) => session.post(method,params,(err,result) => err ? reject(err) : resolve(result)));
+let profileStartMs = 0;
+if (profiled) {
+  session.connect();
+  await post("Profiler.enable");
+  await post("Profiler.setSamplingInterval", { interval: 500 });
+  await post("Profiler.start");
+  profileStartMs = performance.now();
+}
+const result = await runTestPattern(new URL("../packages/cli/test/fixtures/cfc-flow-labels/prepared-digest-repeated.test.tsx", import.meta.url).pathname, {
+  cfcEnforcementMode: "enforce-explicit",
+  cfcFlowLabels: "persist",
+  noIdempotencyCheck: true,
+  verbose: true,
+  statsThreshold: 0,
+});
+const updates = performance.getEntriesByType("measure").filter(e => e.name.startsWith("digest-update/")).map(e => ({ name:e.name,startMs:e.startTime,durationMs:e.duration }));
+const renders = performance.getEntriesByType("measure").filter(e => e.name.startsWith("digest-bench/")).map(e => ({ name:e.name, startMs:e.startTime, durationMs:e.duration }));
+if (profiled) {
+  const {profile} = await post("Profiler.stop");
+  await Deno.writeTextFile(output + ".cpuprofile",JSON.stringify(profile));
+  session.disconnect();
+}
+await Deno.writeTextFile(output + ".json", JSON.stringify({posture:{ cfcEnforcementMode:"enforce-explicit",cfcFlowLabels:"persist" },activityProbe,renders,updates,profileStartMs,cacheHits:getFrozenObjectHashCacheHits(),result}));
+if (result.error || result.runtimeErrors.length || result.results.some(r => !r.passed)) Deno.exit(1);
+Deno.exit(0);

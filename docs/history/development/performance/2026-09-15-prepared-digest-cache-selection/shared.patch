--- /dev/null
+++ b/packages/cli/test/fixtures/cfc-flow-labels/prepared-digest-repeated.test.tsx
@@ -0,0 +1,39 @@
+/** Repeated updates of the same fifty rows under one confidentiality policy. */
+import {
+  action, assert, computed, pattern, sqliteDatabase, type SqliteDb, table, TESTS, UI, Writable,
+} from "commonfabric";
+interface Row { id: number; title: string }
+const MappedRows = pattern<{ db: SqliteDb; revision: number }>(({ db, revision }) => {
+  const query = db.query<Row>("SELECT id, title FROM messages ORDER BY id");
+  const titles = query.result?.map((row) => computed(() => `${row.title} revision ${revision}`));
+  return { query, titles, [UI]: <div>{titles?.map((title) => <p>{title}</p>)}</div> };
+});
+export default pattern(() => {
+  const db = sqliteDatabase({ tables: { messages: table({
+    id: "integer primary key",
+    title: { type: "string", sqlType: "text", ifc: { confidentiality: ["fixture-private"] } },
+  }) } });
+  const seed = action(() => {
+    Array.from({ length: 50 }, (_, i) => i + 1).forEach((id) => {
+      db.exec("INSERT INTO messages (id, title) VALUES (?, ?)", [id, `Message ${id}`]);
+    });
+  });
+  const revision = new Writable(0);
+  const update = action(() => revision.set(revision.get() + 1));
+  const rows = MappedRows({ db, revision });
+  return { [TESTS]: [
+    { action: seed },
+    { assertion: assert(() => rows.query.result?.length === 50) },
+    { render: rows[UI] },
+    { action: update },
+    { render: rows[UI] },
+    { assertion: assert(() => rows.titles?.[0] === "Message 1 revision 1") },
+    { action: update },
+    { render: rows[UI] },
+    { assertion: assert(() => rows.titles?.[0] === "Message 1 revision 2") },
+    { action: update },
+    { render: rows[UI] },
+    { assertion: assert(() => rows.titles?.[0] === "Message 1 revision 3") },
+    { settle: true },
+  ] };
+});
diff --git a/packages/runner/test/cfc-digest-commit.bench.ts b/packages/runner/test/cfc-digest-commit.bench.ts
new file mode 100644
--- /dev/null
+++ b/packages/runner/test/cfc-digest-commit.bench.ts
@@ -0,0 +1,99 @@
+/** Measures prepared-digest work over frozen transaction records. */
+import { getFrozenObjectHashCacheHits } from "@commonfabric/data-model";
+import { Identity } from "@commonfabric/identity";
+
+import { preparedDigestFor } from "../src/cfc/canonical.ts";
+import { Runtime } from "../src/runtime.ts";
+import { StorageManager } from "../src/storage/cache.deno.ts";
+import type { ExtendedStorageTransaction } from "../src/storage/extended-storage-transaction.ts";
+import { benchDiagnostic } from "./bench-diagnostics.ts";
+
+const signer = await Identity.fromPassphrase("cfc-prepared-digest-bench");
+const storageManager = StorageManager.emulate({ as: signer });
+const runtime = new Runtime({
+  apiUrl: new URL("https://example.com"),
+  storageManager,
+});
+
+/** Records a payload and its policy material at a distinct address. */
+function write(tx: ExtendedStorageTransaction, index: number, bytes: number) {
+  const target = {
+    space: signer.did(),
+    scope: "space" as const,
+    id: `of:digest-${index}` as const,
+    path: [],
+  };
+  const value = { text: "x".repeat(bytes), index };
+  tx.writeValueOrThrow(target, value);
+  tx.recordCfcWritePolicyInput({
+    kind: "custom",
+    name: `payload-${index}`,
+    target,
+    value: { value, schema: { type: "object" } },
+  });
+  return target;
+}
+
+for (const writes of [5, 50, 200]) {
+  for (const bytes of [1024, 10240]) {
+    for (const phase of ["prepare-and-recheck"]) {
+      let reported = false;
+      Deno.bench({
+        name: `${writes} writes / ${bytes / 1024} KiB / ${phase}`,
+        group: "prepared digest",
+        fn(b) {
+          const tx = runtime.edit() as ExtendedStorageTransaction;
+          try {
+            const targets = Array.from(
+              { length: writes },
+              (_, index) => write(tx, index, bytes),
+            );
+            for (let index = 0; index < 300; index++) {
+              const target = targets[index % writes];
+              tx.readValueOrThrow(target);
+              tx.recordCfcDereferenceTrace({
+                source: { ...target, path: ["links", String(index)] },
+                target,
+                kind: "value",
+              });
+            }
+            const access = tx.accessForTestingOnly;
+            const input = phase === "warm-parts"
+              ? access.buildPreparedDigestInput()
+              : undefined;
+            const first = phase === "first" || phase === "prepare-and-recheck"
+              ? undefined
+              : input === undefined
+              ? access.preparedDigest()
+              : preparedDigestFor(input);
+            if (phase === "one-write") write(tx, writes, bytes);
+            const hitsBefore = getFrozenObjectHashCacheHits();
+            b.start();
+            const digest = input === undefined
+              ? access.preparedDigest()
+              : preparedDigestFor({ ...input });
+            if (phase === "prepare-and-recheck") {
+              const recheck = access.preparedDigest();
+              if (recheck !== digest) throw new Error("Recheck changed the digest");
+            }
+            b.end();
+            const hits = getFrozenObjectHashCacheHits() - hitsBefore;
+            if (!digest || (phase === "one-write" && digest === first)) {
+              throw new Error("Digest did not bind the added write");
+            }
+            if (
+              (phase === "unchanged" || phase === "warm-parts") &&
+              digest !== first
+            ) throw new Error("Unchanged activity changed the digest");
+            if (!reported) {
+              benchDiagnostic(JSON.stringify({ writes, bytes, phase, hits }));
+              reported = true;
+            }
+          } finally {
+            tx.abort();
+          }
+        },
+      });
+    }
+  }
+}

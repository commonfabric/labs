+          ) => {
+            server.accessForTestingOnly.engineOpener = undefined;
+            entered.resolve();
+            await release.promise;
+            return await open(requested);
+          };
+          pending = server.watchAdd({
+            type: "session.watch.add",
+            requestId: "add",
+            space,
+            sessionId: opened.sessionId,
+            watches: [watch("of:b"), {
+              id: "operation",
+              kind: "operation",
+              query: { id: "of:b", path: toValuePath([]) },
+            }],

# Use bd merge for beads JSONL files
.beads/beads.jsonl merge=beads

# The historical-documentation index is appended to by many branches at once.
# The union driver keeps both sides' additions instead of raising a conflict.
# It works a line at a time, so the file is restricted to one-line entries and
# carries no editable prose; docs/history/README.md explains the rules and
# `deno task check-docs-history-index` enforces them.
docs/history/INDEX.md merge=union

# Keep generated measurement data available without expanding it in code review.
docs/history/**/*.results.json linguist-generated=true

# An iframe pattern's guest bundle is `deno bundle` output, read as a data file
# by the pattern beside it; review its `guest.ts` or `guest.tsx` instead.
patterns/*/iframe-*/**/guest.js linguist-generated=true

# Test-support modules for the UI components, which sit beside the source
# rather than in a test directory.
runtime/ui/src/v2/test-utils/** test

# Test-support modules for pattern tests, which pattern tests import from
# beside the patterns rather than from a test directory.
patterns/tools/test-support/** test
patterns/showcase/battleship/shared/board-view.ts test
patterns/showcase/battleship/multiplayer/room-view.ts test
patterns/system/notes/note-test-fixtures.tsx test

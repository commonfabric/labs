{
  // Dependency guide: ../docs/development/DEPENDENCIES.md
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.0.12",
    "typescript": "npm:typescript@6.0.3"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ./run-member-tests.ts deno-test",
    // --no-check: tasks/ is type-checked by the root `deno task check`.
    // `test.ts` is the root `deno task test` runner, which Deno's discovery
    // would otherwise take for a test module by its name.
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --no-check -A --ignore=test.ts"
  }
}

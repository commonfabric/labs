{
  "name": "@commonfabric/state-inspector",
  "version": "0.0.1",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "check": "deno check .",
    "inspect": "deno run --allow-read --allow-ffi --allow-env --allow-net ./cli.ts",
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-read --allow-write --allow-ffi --allow-env --allow-net",
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}

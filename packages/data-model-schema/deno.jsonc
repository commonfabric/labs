{
  "name": "@commonfabric/data-model-schema",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@/": "./src/"
  },
  "tasks": {
    "check": "deno check .",
    "deno-test": {
      "description": "Run unit tests",
      "command": "deno test --shuffle=$(deno task -q test-seed) --allow-env=CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST"
    },
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test"
  },
  "test": {
    "include": [
      "test/**/*.test.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema-closure": "./src/schema-closure.ts",
    "./schema-refs": "./src/schema-refs.ts",
    "./schema-walk": "./src/schema-walk.ts"
  }
}

{
  "name": "@commonfabric/cli",
  "tasks": {
    "cli": "deno run --allow-run --allow-env --allow-read ./launcher.ts --labs-root ../.. --config ../../deno.jsonc --cli-entrypoint ./mod.ts --",
    "cli-no-pwd-override": "CF_CLI_NAME=cf deno run --allow-net --allow-ffi --allow-read --allow-write --allow-env --allow-run ./mod.ts",
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    "deno-test": "deno run --allow-env --allow-read --allow-write --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-sharded-test-files.ts CLI_TEST_SHARD cli . --serial='**/*.serial.test.ts' --all-access=test/view-procfs.test.ts -- --no-check --parallel --allow-ffi --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 --ignore='**/*.test.tsx',test/piece-integration.test.ts --shuffle=$(deno task -q test-seed)",
    "integration": "CF_CLI_INTEGRATION_USE_LOCAL=1 CF_LOG_LEVEL=error ./integration/integration.sh",
    "fuse-integration": "CF_CLI_INTEGRATION_USE_LOCAL=1 CF_LOG_LEVEL=error ./integration/fuse-exec.sh",
    "acl-integration": "CF_CLI_INTEGRATION_USE_LOCAL=1 CF_LOG_LEVEL=error ./integration/acl.sh"
  },
  "exports": {
    // An entry is the contract this package owes a caller outside it, so a
    // module reached only from within stays on relative paths, and a module
    // that grows an outside caller earns one then. `.` is the package's own
    // rather than an answer to a caller: a member declaring a `name` owes an
    // `exports` map, and importing this one builds the whole command tree.
    ".": "./mod.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    // Cliffy and @std/fmt/colors roll as one set; see "Cliffy" there.
    "@cliffy/flags": "jsr:@cliffy/flags@1.0.0-rc.8",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.8",
    "@node/child_process": "node:child_process",
    "@std/fmt/colors": "jsr:@std/fmt@~1.0.2/colors",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "entities": "npm:entities@^8.0.0",
    "marked": "npm:marked@^18.0.6",
    "@binclusive/tree-sitter-swift-wasm": "npm:@binclusive/tree-sitter-swift-wasm@0.1.0",
    "tree-sitter-python": "npm:tree-sitter-python@0.25.0",
    "typescript": "npm:typescript@6.0.3",
    "web-tree-sitter": "npm:web-tree-sitter@0.26.12"
  }
}

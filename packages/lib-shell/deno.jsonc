{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/lib-shell",
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-read --allow-write --allow-run --allow-env test/*.test.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./credentials": "./src/credentials.ts",
    "./runtime": "./src/runtime.ts"
  }
}

{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/test-support",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./bench-worker": "./src/bench-worker.ts",
    "./clock-preload": "./test/clock-preload.ts",
    "./compile-byte-cache": "./src/compile-byte-cache.ts",
    "./fixture-runner": "./src/fixture-runner.ts",
    "./isolated-deno": "./src/isolated-deno.ts",
    "./records": "./src/records/mod.ts",
    "./shuffle": "./src/shuffle.ts",
    "./stuck-net": "./test/stuck-net.ts"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    // The tests spawn the Deno running them, and a bare `--allow-run=deno`
    // would not permit that: Deno resolves the allowlist entry through `PATH`,
    // which is a different binary whenever the shell's Deno is not the pinned
    // one. A task line runs the Deno running the task, so asking that Deno for
    // its own path allows exactly the one binary the tests start.
    // Repository tools are outside the workspace, so list their regression
    // tests here to keep them in the normal workspace test suite.
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --frozen=true --allow-env=CF_COMPILE_CACHE_FILE,CF_TEST_RECORDS_DIR,CF_TEST_SHUFFLE_SEED,CF_TEST_SKIP_LIST --allow-read --allow-write --allow-run=git,\"$(deno eval \"console.log(Deno.execPath())\")\" src/*.test.ts src/records/*.test.ts test/*.test.ts test/records/*.test.ts ../../tools/write-iframe-wrapper.test.ts",
    "check": "deno check src/**/*.ts test/clock-preload.ts test/stuck-net.ts",
    "fmt": "deno fmt src/ test/",
    "lint": "deno lint src/ test/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  }
}

{
  "argumentSchema": {
    "$defs": {
      "AboutRecord": {
        "properties": {
          "createdAt": {
            "description": "When the room was created.",
            "type": "FabricEpochNsec"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "How the room was created."
          },
          "title": {
            "description": "A group room's title.",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ChatIndexEntry": {
        "properties": {
          "counterpart": {
            "description": "A direct room's other member, by principal.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "The room's kind, as its `about.kind` says."
          },
          "room": {
            "$ref": "#/$defs/ChatRoomLink",
            "asCell": [
              "cell"
            ],
            "description": "The room."
          },
          "since": {
            "description": "When this user created or accepted it.",
            "type": "FabricEpochNsec"
          }
        },
        "required": [
          "room",
          "kind",
          "since"
        ],
        "type": "object"
      },
      "ChatManagerNotice": {
        "properties": {
          "id": {
            "description": "The notice's id, unique in the manager.",
            "type": "string"
          },
          "recipient": {
            "description": "The DID of the person admitted.",
            "type": "string"
          },
          "room": {
            "$ref": "#/$defs/ChatRoomLink",
            "asCell": [
              "cell"
            ],
            "description": "The room the recipient was admitted to."
          }
        },
        "required": [
          "id",
          "room",
          "recipient"
        ],
        "type": "object"
      },
      "ChatRequestOutcome": {
        "anyOf": [
          {
            "properties": {
              "status": {
                "description": "The request has not finished.",
                "enum": [
                  "pending"
                ],
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "entry": {
                "$ref": "#/$defs/ChatIndexEntry",
                "description": "The entry it produced; absent for `forget`."
              },
              "status": {
                "description": "The request finished.",
                "enum": [
                  "done"
                ],
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "reason": {
                "description": "Why.",
                "type": "string"
              },
              "status": {
                "description": "The request was refused.",
                "enum": [
                  "refused"
                ],
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "ChatRoomAbout": {
        "properties": {
          "createdAt": {
            "description": "When the room was created; absent for a space's own chat.",
            "type": "FabricEpochNsec"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "`\"direct\"` if created as a direct room; `\"group\"` otherwise."
          },
          "policy": {
            "$ref": "#/$defs/ChatRoomPolicy",
            "asCell": [
              "cell"
            ],
            "description": "The room's policy, stated correctly, in a document of its own."
          },
          "record": {
            "$ref": "#/$defs/AboutRecord",
            "asCell": [
              "cell"
            ],
            "description": "The record the room's creator wrote, whose label names them; absent for a\nspace's own chat, which no one created as a room."
          },
          "title": {
            "description": "A group room's title. A direct room, and a space's own chat, have none.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "policy"
        ],
        "type": "object"
      },
      "ChatRoomKind": {
        "enum": [
          "direct",
          "group"
        ]
      },
      "ChatRoomLink": {
        "properties": {
          "about": {
            "$ref": "#/$defs/ChatRoomAbout",
            "description": "What the room says about itself."
          },
          "messages": {
            "description": "Where the conversation stands: what of `messages` every member shares.",
            "properties": {
              "count": {
                "description": "How many messages the room holds, obliterated tombstones included.",
                "type": "number"
              },
              "newestAt": {
                "description": "The newest message's `sentAt`; absent while there are none.",
                "type": "FabricEpochNsec"
              }
            },
            "required": [
              "count"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "ChatRoomPolicy": {
        "properties": {
          "deletionIsObliteration": {
            "description": "Whether a sender's deletion of their own message obliterates it.",
            "type": "boolean"
          },
          "keepsHistory": {
            "description": "Whether an edit or a plain deletion keeps the version it replaces.",
            "type": "boolean"
          },
          "maxOpenWindows": {
            "description": "The most message windows a session can have open.",
            "type": "number"
          },
          "maxWindowCount": {
            "description": "The most messages a message window holds.",
            "type": "number"
          },
          "ownersMayObliterate": {
            "description": "Whether an OWNER may obliterate messages.",
            "type": "boolean"
          },
          "proposedTimeMaxAgeNsec": {
            "description": "How far before the room's clock a proposed time is accepted, in ns.",
            "type": "FabricDurationNsec"
          },
          "proposedTimeMaxLeadNsec": {
            "description": "How far after the room's clock a proposed time is accepted, in ns.",
            "type": "FabricDurationNsec"
          },
          "recentActivityWindowNsec": {
            "description": "How long an entry stays in `recentActivity`, in ns.",
            "type": "FabricDurationNsec"
          }
        },
        "required": [
          "ownersMayObliterate",
          "keepsHistory",
          "deletionIsObliteration",
          "proposedTimeMaxAgeNsec",
          "proposedTimeMaxLeadNsec",
          "recentActivityWindowNsec",
          "maxWindowCount",
          "maxOpenWindows"
        ],
        "type": "object"
      }
    },
    "description": "What a manager stores. Every field has a default.",
    "properties": {
      "direct": {
        "additionalProperties": {
          "$ref": "#/$defs/ChatIndexEntry"
        },
        "asCell": [
          "cell"
        ],
        "default": {},
        "description": "The direct room shared with each counterpart.",
        "properties": {},
        "type": "object"
      },
      "outgoingNotices": {
        "asCell": [
          "cell"
        ],
        "default": [],
        "description": "Notices waiting for a client to deliver them.",
        "items": {
          "$ref": "#/$defs/ChatManagerNotice"
        },
        "type": "array"
      },
      "requests": {
        "additionalProperties": {
          "$ref": "#/$defs/ChatRequestOutcome"
        },
        "asCell": [
          "cell"
        ],
        "default": {},
        "description": "Each request's outcome.",
        "properties": {},
        "type": "object"
      },
      "rooms": {
        "asCell": [
          "cell"
        ],
        "default": [],
        "description": "The rooms this user belongs to.",
        "items": {
          "$ref": "#/$defs/ChatIndexEntry"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "pattern": "fabrichat/manager.tsx",

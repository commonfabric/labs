            "$ref": "#/$defs/ChatManagerProfile",
            "description": "A direct room's other member's profile, through whose share inbox a new\nroom is offered to them."
          },
          "requestId": {
            "description": "Chosen by the sender; the outcome is recorded under it, except for a start\nthat would create a room without its reviewed `ChatStart`, which is\nrefused whole and records none.",
            "type": "string"
          },
          "room": {
            "$ref": "#/$defs/ChatRoomLink",
            "description": "A room to accept or forget."
          },
          "target": {
            "description": "A rendered control's text, or the profile it starts a direct room with.",
            "properties": {
              "dataset": {
                "description": "The principal an older room's chip names the person by.",
                "properties": {
                  "counterpart": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "name": {
                "$ref": "#/$defs/ChatManagerProfile",

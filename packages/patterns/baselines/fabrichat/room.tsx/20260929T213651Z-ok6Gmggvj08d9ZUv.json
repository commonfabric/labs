          "nextSeq": {
            "description": "The `seq` the next entry takes.",
            "type": "number"
          }
        },
        "required": [
          "nextSeq",
          "expiredThrough"
        ],
        "type": "object"
      },
      "ChatDeletedBody": {
        "properties": {

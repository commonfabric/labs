{
  "argumentSchema": {
    "$defs": {
      "ChatProfile": {
        "properties": {
          "avatar": {
            "description": "The person's avatar: a URL or a glyph, if they have set one.",
            "type": "string"
          },
          "name": {
            "description": "The person's display name, if they have set one.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChatReaction": {
        "properties": {
          "emoji": {
            "description": "A single emoji.",
            "type": "string"
          },
          "reactorProfile": {
            "$ref": "#/$defs/ChatProfile",
            "asCell": [
              "cell"
            ],
            "description": "The profile the reactor reacted under."
          },
          "sentAt": {
            "description": "When the room recorded the reaction. Unique in the room.",
            "type": "FabricEpochNsec"
          }
        },
        "required": [
          "reactorProfile",
          "emoji",
          "sentAt"
        ],
        "type": "object"
      },
      "ChatRoomAbout": {
        "properties": {
          "createdAt": {
            "description": "When the room was created; absent for a space's own chat.",
            "type": "FabricEpochNsec"
          },
          "kind": {
            "$ref": "#/$defs/ChatRoomKind",
            "description": "`\"direct\"` if created as a direct room; `\"group\"` otherwise."
          },
          "policy": {
            "$ref": "#/$defs/ChatRoomPolicy",
            "description": "The room's policy, stated correctly, in a document of its own."
          },
          "title": {
            "description": "A group room's title. A direct room, and a space's own chat, have none.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "policy"
        ],
        "type": "object"
      },
      "ChatRoomActivity": {
        "properties": {
          "at": {
            "description": "When the room recorded it. Unique in the room.",
            "type": "FabricEpochNsec"
          },
          "requestId": {
            "description": "The `requestId` of the event it records.",
            "type": "string"
          },
          "seq": {
            "description": "The entry's place in the room's activity: 1, 2, 3, … with no gaps.",
            "type": "number"
          },
          "what": {
            "asCell": [
              "cell"
            ],
            "description": "The thing the event changed or added: a message, or the room's\nmembership, as the room offers it (its `roster`).",
            "type": "unknown"
          }
        },
        "required": [
          "seq",
          "at",
          "requestId",
          "what"
        ],
        "type": "object"
      },
      "ChatRoomKind": {
        "enum": [
          "direct",
          "group"
        ]
      },
      "ChatRoomPolicy": {
        "properties": {
          "deletionIsObliteration": {
            "description": "Whether a sender's deletion of their own message obliterates it.",
            "type": "boolean"
          },
          "keepsHistory": {
            "description": "Whether an edit or a plain deletion keeps the version it replaces.",
            "type": "boolean"
          },
          "maxOpenWindows": {
            "description": "The most message windows a session can have open.",
            "type": "number"
          },
          "maxWindowCount": {
            "description": "The most messages a message window holds.",
            "type": "number"
          },
          "ownersMayObliterate": {
            "description": "Whether an OWNER may obliterate messages.",
            "type": "boolean"
          },
          "proposedTimeMaxAgeNsec": {
            "description": "How far before the room's clock a proposed time is accepted, in ns.",
            "type": "integer"
          },
          "proposedTimeMaxLeadNsec": {
            "description": "How far after the room's clock a proposed time is accepted, in ns.",
            "type": "integer"
          },
          "recentActivityWindowNsec": {
            "description": "How long an entry stays in `recentActivity`, in ns.",
            "type": "integer"
          }
        },
        "required": [
          "ownersMayObliterate",
          "keepsHistory",
          "deletionIsObliteration",
          "proposedTimeMaxAgeNsec",
          "proposedTimeMaxLeadNsec",
          "recentActivityWindowNsec",
          "maxWindowCount",
          "maxOpenWindows"
        ],
        "type": "object"
      },
      "PlacedMessage": {
        "properties": {
          "reactions": {
            "description": "Everyone's reactions to the message.",
            "items": {
              "$ref": "#/$defs/ChatReaction"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "PlacedMessageList": {
        "properties": {
          "count": {
            "description": "How many messages the room holds.",
            "type": "number"
          },
          "latest": {
            "description": "The newest messages of the main conversation.",
            "properties": {
              "hasOlder": {
                "type": "boolean"
              },
              "messages": {
                "items": {
                  "$ref": "#/$defs/PlacedMessage",
                  "asCell": [
                    "cell"
                  ]
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "windows": {
            "additionalProperties": {
              "properties": {
                "messages": {
                  "items": {
                    "$ref": "#/$defs/PlacedMessage",
                    "asCell": [
                      "cell"
                    ]
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "description": "The reading session's windows.",
            "properties": {},
            "type": "object"
          }
        },
        "type": "object"
      },
      "PlacedRoom": {
        "properties": {
          "about": {
            "$ref": "#/$defs/ChatRoomAbout",
            "description": "What the room says about itself."
          },
          "canSend": {
            "description": "Whether the reader can send.",
            "type": "boolean"
          },
          "messages": {
            "$ref": "#/$defs/PlacedMessageList",
            "description": "The room's messages."
          },
          "participants": {
            "description": "The room's participants.",
            "items": {
              "$ref": "#/$defs/ChatProfile",
              "asCell": [
                "cell"
              ]
            },
            "type": "array"
          },
          "recentActivity": {
            "description": "What the room recorded recently.",
            "items": {
              "$ref": "#/$defs/ChatRoomActivity"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "description": "What a placement holds.",
    "properties": {
      "room": {
        "$ref": "#/$defs/PlacedRoom",
        "asCell": [
          "cell"
        ],
        "description": "The room, set when the placement is created."
      }
    },
    "required": [
      "room"
    ],
    "type": "object"
  },
  "pattern": "fabrichat/placement.tsx",

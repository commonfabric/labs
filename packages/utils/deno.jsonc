{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/utils",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-env=CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST --no-check",
    "bench": {
      "description": "Run benchmarks",
      "command": "deno bench"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./arrays": "./src/arrays.ts",
    "./async-local-store": "./src/async-local-store.ts",
    "./base64url": "./src/base64url.ts",
    "./bigint": "./src/bigint.ts",
    "./buffers": "./src/buffers.ts",
    "./build-info": "./src/build-info.ts",
    "./cache": "./src/cache.ts",
    "./deep-equal": "./src/deep-equal.ts",
    "./hashtags": "./src/hashtags.ts",
    "./defer": "./src/defer.ts",
    "./encoding": "./src/encoding.ts",
    "./env": "./src/env.ts",
    "./equal-ignoring-symbols": "./src/equal-ignoring-symbols.ts",
    "./framework-result-keys": "./src/framework-result-keys.ts",
    "./index-tracking-stack": "./src/index-tracking-stack.ts",
    "./json-pointer": "./src/json-pointer.ts",
    "./loopback": "./src/loopback.ts",
    "./logger": "./src/logger.ts",
    "./markdown": "./src/markdown.ts",
    "./objects": "./src/objects.ts",
    "./path-key-map": "./src/path-key-map.ts",
    "./remove-directory": "./src/remove-directory.ts",
    "./sandbox-contract": "./src/sandbox-contract.ts",
    "./sleep": "./src/sleep.ts",
    "./string-tuple-key": "./src/string-tuple-key.ts",
    "./staged-map": "./src/staged-map.ts",
    "./strip-undefined-props": "./src/strip-undefined-props.ts",
    "./two-level-weak-cache": "./src/two-level-weak-cache.ts",
    "./types": "./src/types.ts",
    "./utf8": "./src/utf8.ts",
    "./wtf8": "./src/wtf8.ts",
    "./zod-utils": "./src/zod-utils.ts"
  }
}

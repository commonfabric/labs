{
  "name": "@commonfabric/leb128",
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@/": "./src/"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-env=CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST"
  },
  "test": {
    "include": [
      "test/*.test.ts"
    ]
  }
}

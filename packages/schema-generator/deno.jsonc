{
  "name": "@commonfabric/schema-generator",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./cell-brand": "./src/typescript/cell-brand.ts",
    "./common-fabric-symbols": "./src/typescript/common-fabric-symbols.ts",
    "./default-brand": "./src/typescript/default-brand.ts",
    "./wrapper-names": "./src/typescript/wrapper-names.ts",
    "./property-optionality": "./src/typescript/property-optionality.ts",
    "./property-name": "./src/typescript/property-name.ts",
    "./scope-brand": "./src/typescript/scope-brand.ts",
    "./numeric-expression": "./src/typescript/numeric-expression.ts",
    "./type-node": "./src/typescript/type-node.ts",
    "./writer-binding": "./src/typescript/writer-binding.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "typescript": "npm:typescript@6.0.3"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --parallel --allow-read --allow-write --allow-run --allow-env=API_URL,\"TSC_*\",NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,UPDATE_GOLDENS,FIXTURE,SKIP_INPUT_CHECK,CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST test/**/*.test.ts",
    "test:check": "deno test --shuffle=$(deno task -q test-seed) --allow-read --allow-write --allow-run --allow-env=API_URL,\"TSC_*\",NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,UPDATE_GOLDENS,FIXTURE,SKIP_INPUT_CHECK,CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST test/**/*.test.ts",
    "check": "deno check src/**/*.ts test/*.ts test/schema/**/*.ts test/typescript/**/*.ts",
    "fmt": "deno fmt src/ test/",
    "lint": "deno lint src/ test/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  }
}

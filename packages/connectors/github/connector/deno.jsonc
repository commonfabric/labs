{
  "name": "@commonfabric/github-connector",
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../../../tasks/run-member-tests.ts deno-test",
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-env --allow-read --allow-write --allow-run --allow-ffi --allow-sys=homedir,uid"
  },
  "exports": {
    ".": "./mod.ts",
    "./client": "./src/client.ts",
    "./fabric": "./src/fabric.ts",
    "./identity": "./src/identity.ts",
    "./status": "./src/status.ts",
    "./types": "./src/types.ts"
  }
}

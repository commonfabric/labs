{
  "name": "@commonfabric/cf-harness",
  "tasks": {
    "run": "deno run -A src/main.ts",
    "help": "deno run -A src/main.ts --help",
    "console:build": "cd console && deno run -A ../../felt/cli.ts build .",
    "console:watch": "cd console && deno run -A ../../felt/cli.ts dev .",
    "console": "deno task console:build && deno run -A console/server.ts",
    "console:launch": "deno task console:build && deno run -A console/launch.ts",
    "test": "ENV=test deno test --allow-read --allow-write --allow-run --allow-ffi --allow-net --allow-env test audit/test",
    "cfc-audit": "deno run --allow-read --allow-net audit/cli.ts",
    "cfc-audit-fixtures": "deno run --allow-read --allow-write --allow-env --allow-net audit/test/regenerate-fixtures.ts",
    "probe-skills-sh": "deno run --allow-net=skills.sh scripts/probe-skills-sh.ts",
    "measure-runs": "deno run --allow-read scripts/measure-runs.ts",
    "measure-batch": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run=git scripts/run-measurement-batch.ts",
    "seed-pattern-index": "deno run -A scripts/seed-pattern-index.ts"
  },
  "exports": {
    ".": "./mod.ts",
    "./config": "./src/config.ts",
    "./engine": "./src/engine.ts",
    "./prompt-loop": "./src/prompt-loop.ts",
    "./interactive-chat-service": "./src/interactive-chat-service.ts",
    "./interactive-chat-stdio": "./src/interactive-chat-stdio.ts",
    "./loom-local-host": "./src/loom-local-host.ts",
    "./loom-local-host-main": "./src/loom-local-host-main.ts",
    "./session-store": "./src/session-store.ts",
    "./sqlite-session-store": "./src/sqlite-session-store.ts",
    "./subagent-return": "./src/subagent-return.ts",
    "./artifacts": "./src/artifacts.ts",
    "./cli": "./src/cli.ts",
    "./provenance": "./src/provenance.ts",
    "./result-writer": "./src/result-writer.ts",
    "./gateway/openai-client": "./src/gateway/openai-client.ts",
    "./model/client": "./src/model/client.ts",
    "./model/usage": "./src/model/usage.ts",
    "./model/openai-compatible-gateway": "./src/model/openai-compatible-gateway.ts",
    "./model/openai-codex-responses": "./src/model/openai-codex-responses.ts",
    "./auth/types": "./src/auth/types.ts",
    "./auth/credential-store": "./src/auth/credential-store.ts",
    "./auth/openai-codex": "./src/auth/openai-codex.ts",
    "./auth/provider-settings": "./src/auth/provider-settings.ts",
    "./control-errors": "./src/control-errors.ts",
    "./contracts/prompt-slot": "./src/contracts/prompt-slot.ts",
    "./contracts/cfc-invocation-context": "./src/contracts/cfc-invocation-context.ts",
    "./contracts/native-model-tool": "./src/contracts/native-model-tool.ts",
    "./contracts/image": "./src/contracts/image.ts",
    "./contracts/run-manifest": "./src/contracts/run-manifest.ts",
    "./contracts/observation": "./src/contracts/observation.ts",
    "./contracts/policy": "./src/contracts/policy.ts",
    "./contracts/run-report": "./src/contracts/run-report.ts",
    "./contracts/skill": "./src/contracts/skill.ts",
    "./contracts/subagent": "./src/contracts/subagent.ts",
    "./contracts/interactive-chat": "./src/contracts/interactive-chat.ts",
    "./contracts/tool-result": "./src/contracts/tool-result.ts",
    "./contracts/tool-descriptor": "./src/contracts/tool-descriptor.ts",
    "./contracts/transcript": "./src/contracts/transcript.ts",
    "./sandbox": "./src/sandbox/docker-runsc.ts",
    "./tools": "./src/tools/registry.ts",
    "./tools/read-skill-resource": "./src/tools/read-skill-resource.ts",
    "./tools/web-fetch": "./src/tools/web-fetch.ts",
    "./skills/registry": "./src/skills/registry.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@db/sqlite": "jsr:@db/sqlite@0.13.0"
  }
}

{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/runtime-client",
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@/": "./src/"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --no-check --allow-env --allow-read --allow-ffi test/",
    "integration": "LOG_LEVEL=warn deno test --shuffle=$(deno task -q test-seed) -A $INTEGRATION_TEST_FLAGS \"./integration/*.test.ts\"",
    // --allow-read so that a benchmark may start a `Worker`, which reads the
    // worker's module from disk. The crossing benchmark measures a real
    // `postMessage()`, that being the boundary the connection is. --allow-ffi
    // and --allow-env are what an emulated runtime needs, whose storage is
    // SQLite reached over FFI: a benchmark reads its subject through one, so
    // that the value it times is what a read hands back.
    "bench": "deno bench --allow-read --allow-ffi --allow-env --no-check bench/"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./transports/message-port": "./src/client/transports/message-port/transport-message-port.ts",
    "./transports/web-worker": "./src/client/transports/web-worker/transport-web-worker.ts"
  }
}

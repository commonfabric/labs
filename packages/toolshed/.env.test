ENV=test
PORT=9999
LOG_LEVEL=silent
IDENTITY=./test.key
# Disable the Tailscale-only LLM gateway in tests; it is unreachable in CI and
# its startup model-discovery fetch (models.ts) would otherwise time out.
CFTS_AI_GATEWAY_URL=
# Rate limiting keys on the real TCP peer, which `app.request` does not provide,
# so every test would otherwise share one bucket and later tests would 429.
# Trusting the header here lets each test declare its own client, and exercises
# the trusted-proxy branch of `clientKey` while it is at it.
RATE_LIMIT_TRUST_FORWARDED_FOR=true

# The self-serve control plane is opt-in and OFF by default (see env.ts). The
# route suites need it mounted; the default itself is pinned in env.test.ts.
INGEST_SELF_SERVE_ENABLED=true

# Gmail push ingest is off unless both of these are set. The route suites need
# it mounted; no test here fetches Google's signing keys.
INGEST_GMAIL_PUSH_AUDIENCE=https://toolshed.test/api/ingest-push/gmail
INGEST_GMAIL_PUSH_SERVICE_ACCOUNTS=gmail-push@toolshed-test.iam.gserviceaccount.com

{
  "tasks": {
    "dev": "deno run --unstable-otel -A --watch --env-file=.env index.ts",
    "production": "deno run --unstable-otel -A --env-file=.env index.ts",
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    "deno-test": "ENV=test deno test --shuffle=$(deno task -q test-seed) --no-check -A --env-file=.env.test",
    "llm-exercise": "deno run --allow-env --allow-net ./scripts/llm-exercise.ts",
    "provision-ingest-channel": "deno run -A --env-file=.env scripts/provision-ingest-channel.ts",
    "audit-ingest-channels": "deno run -A --env-file=.env scripts/audit-ingest-channels.ts",
    "retire-ingest-channels": "deno run -A --env-file=.env scripts/retire-ingest-channels.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@/": "./",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "@node/async_hooks": "node:async_hooks",
    "ai": "npm:ai@^7.0.31",
    "@cmd-johnson/oauth2-client": "jsr:@cmd-johnson/oauth2-client@^2.0.0",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^4.0.16",
    "@ai-sdk/google-vertex": "npm:@ai-sdk/google-vertex@^5.0.22",
    "@ai-sdk/groq": "npm:@ai-sdk/groq@^4.0.12",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^4.0.16",
    "@ai-sdk/otel": "npm:@ai-sdk/otel@^1.0.31",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "ajv": "npm:ajv@^8.20.0",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@^2.9.0",
    "@opentelemetry/core": "npm:@opentelemetry/core@^2.9.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@^2.9.0",
    "@arizeai/openinference-semantic-conventions": "npm:@arizeai/openinference-semantic-conventions@^2.5.0",
    "@arizeai/openinference-vercel": "npm:@arizeai/openinference-vercel@^3.1.0",
    "@fal-ai/client": "npm:@fal-ai/client@^1.10.1",
    "@hono/hono": "npm:hono@^4.12.31",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.5.1",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "npm:@opentelemetry/exporter-trace-otlp-proto@^0.220.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@^2.9.0",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.11.11",
    "hono-pino": "npm:hono-pino@^0.10.3",
    "pino": "npm:pino@^10.3.1",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "plaid": "npm:plaid@^43.0.0",
    "stoker": "npm:stoker@^2.0.1"
  }
}

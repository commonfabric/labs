{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/iframe-sandbox",
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test browser-test",
    // The `*.browser.test.ts` name is what routes a file: the glob keeps it
    // out of the plain `deno test` run and hands it to the browser runner.
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-env=CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST --allow-read --ignore='**/*.browser.test.ts'",
    "browser-test": "deno run --allow-env --allow-read --allow-write --allow-run --allow-net ../deno-web-test/cli.ts **/*.browser.test.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./guest": "./src/guest.ts",
    "./react": "./src/react.ts"
  },
  "imports": {
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom/client": "npm:@types/react-dom@19.2.5/client.d.ts",
    "react": "npm:react@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client"
  }
}

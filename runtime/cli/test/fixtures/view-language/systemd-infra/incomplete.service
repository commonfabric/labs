[Unit]
Description=Drop IPv4 TCP packets with options until the kernel fixes CVE-2026-98432
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=
ExecStartPre=-/usr/sbin/nft delete table ip \
ExecStart=/usr/sbin/nft -f "/etc/nftables.d/cve-2026-98432.nft

[Inst

#!/usr/bin/env bash
# Boot-time entry point for a CI spot runner VM.
#
# Baked images (image/provision.sh) already have the runner user, toolchain
# and runner binary, so this script only fetches a one-time JIT config from
# the controller and runs exactly one job. On the stock Ubuntu image every
# install step below runs for real, which is slow but correct.
set -euo pipefail
exec > >(tee -a /dev/console | logger -t ci-runner) 2>&1

CONTROLLER_URL="${controller_url}"
TOKEN_AUDIENCE="${token_audience}"
INSTALL_DOCKER="${install_docker}"
RUNNER_USER="runner"
RUNNER_DIR="/opt/actions-runner"
TOOL_CACHE="/opt/hostedtoolcache"
METADATA="http://metadata.google.internal/computeMetadata/v1"
JIT_MAX_ATTEMPTS=120

# stderr: request_jit_config runs inside a command substitution, and its
# log lines must not end up in the captured JSON.
log() { printf '[ci-runner] %s\n' "$1" >&2; }

metadata() {
  curl -fsS -H 'Metadata-Flavor: Google' "$${METADATA}/$1"
}

identity_token() {
  # format=full puts the instance name, id, zone and project in the token;
  # the controller trusts those, not the request body.
  metadata "instance/service-accounts/default/identity?audience=$${TOKEN_AUDIENCE}&format=full"
}

request_jit_config() {
  local token instance_name zone out hdr code wait attempt=0
  token="$(identity_token)"
  out="$(mktemp)"
  hdr="$(mktemp)"
  # (The doubled percent sign is templatefile's escape for curl's -w format.)
  while :; do
    attempt=$((attempt + 1))
    code="$(curl -sS -o "$${out}" -D "$${hdr}" -w '%%{http_code}' --max-time 120 \
      -X POST "$${CONTROLLER_URL}/jit-config" \
      -H "Authorization: Bearer $${token}" -H 'Content-Type: application/json' --data '{}' 2>/dev/null || true)"
    if [[ "$${code}" == "200" ]]; then
      cat "$${out}"
      rm -f "$${out}" "$${hdr}"
      return 0
    fi
    sleep "$${wait:-5}"
  done
}

install_preemption_watcher() {
  cat >/run/ci-runner-watch-preemption <<'WATCHER'
${preemption_watcher

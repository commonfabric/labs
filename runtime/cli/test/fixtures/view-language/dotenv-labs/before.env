# See docs/development/CONFIGURATION.md for a categorized reference of every
# var below (and how it interacts with the shell and CLI).

ENV=development
PORT=8000
LOG_LEVEL=debug

## OpenTelemetry Configuration
# Enable or disable OpenTelemetry tracing.
OTEL_ENABLED=false
# Service name for traces (use "toolshed" in deployed environments)
OTEL_SERVICE_NAME=toolshed-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

## Gateway (Common Fabric LLM gateway)
# CFTS_AI_GATEWAY_URL=
# CFTS_AI_GATEWAY_URL=""        # explicitly disable

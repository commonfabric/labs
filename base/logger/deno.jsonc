{
  // Dependency guide: ../../docs/development/DEPENDENCIES.md
  "name": "@commonfabric/logger",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ../../tasks/run-member-tests.ts deno-test",
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    // LOG_LEVEL and LOG_TO_STDERR: tests set them to reach the configuration
    // they select.
    "deno-test": "deno test --shuffle=$(deno task -q test-seed) --allow-env=CF_TEST_RECORDS_DIR,CF_TEST_SKIP_LIST,LOG_LEVEL,LOG_TO_STDERR --allow-read=src,test --no-check"
  },
  "exports": {
    ".": "./src/logger.ts"
  }
}

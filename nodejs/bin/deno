#!/bin/bash
#
# The `deno` stand-in's entry point: runs `deno.mjs` with this command line.
#
# Node acts on an `--env-file` anywhere on its command line, the script's own
# arguments included (seen in Node 26.11), so `deno run --env-file=.env ...`
# would make Node fail on a missing `.env` before the stand-in's code ran.
# The flag is renamed `--cf-env-file` here, where Node cannot see it, and
# `deno-as-node` translates that name.

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

args=()
for arg in "$@"; do
  case "${arg}" in
    --env-file|--env-file=*)
      args+=("--cf-${arg#--}")
      ;;
    *)
      args+=("${arg}")
      ;;
  esac
done

exec node "${dir}/deno.mjs" "${args[@]}"

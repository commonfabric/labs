# Temp dir created by docs/check.ts while type-checking doc code blocks
docs/.doccheck*

# Temp deno configs written at the repo root by `runDenoCheckWithTemporaryConfig`
# (packages/test-support/src/isolated-deno.ts). It removes each one in a
# `finally`, so these survive only when a run is interrupted -- at which point
# `git add -A` will happily commit one, and `deno fmt --check` then rejects it.
.deno.standard-decorators.*.json

# Uncompiled source written under tasks/ by tasks/write-coverage-lcov.test.ts,
# which needs a tracked file the Deno cache holds no transpiled form of. It
# removes each one in a `finally`, so these survive only when a run is
# interrupted, at which point `git add -A` would otherwise commit one.
tasks/.write-lcov-uncompiled.*.ts

# What `scripts/topics-computation-cost.ts --derive-limits` prints, which the
# re-derive command in docs/development/BENCHMARKS.md moves over the Topics
# read-budget limits table once the derivation succeeds. A failed derivation
# leaves this file behind holding the counts it did observe.
topics-read-budget-limits.derived
